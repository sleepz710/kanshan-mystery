[Unit]
Description=Kanshan mystery theatre
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=kanshan
Group=kanshan
WorkingDirectory=/opt/kanshan-mystery
Environment=PYTHONUNBUFFERED=1
ExecStart=/opt/kanshan-mystery/.venv/bin/python -m uvicorn deploy.gateway:create_app --factory --host 127.0.0.1 --port 8000 --workers 1 --no-proxy-headers
Restart=on-failure
RestartSec=3
UMask=0077

[Install]
WantedBy=multi-user.target
