# 默认模拟模式：无需模型服务或密钥，可以完成前后端联调。
LLM_MOCK=1

# 填写密钥后将 LLM_MOCK 改为 0。编剧与演员共用服务商时只填这一组。
LLM_BASE_URL=https://api.deepseek.com
LLM_API_KEY=
# 旧版游戏客户端仍读取 LLM_MODEL；任务 02 升级后使用下面两组模型。
LLM_MODEL=deepseek-flash
LLM_ACTOR_MODEL=deepseek-flash
LLM_WRITER_MODEL=deepseek-v4-pro
# 编剧单独使用其他 OpenAI 兼容服务时填写，留空复用上面的地址和密钥。
LLM_WRITER_BASE_URL=
LLM_WRITER_API_KEY=
