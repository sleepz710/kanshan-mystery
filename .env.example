# 默认模拟模式：无需模型服务或密钥，可以完成前后端联调。
LLM_MOCK=1

# 真实调用时填写密钥，并将 LLM_MOCK 改为 0。
# DeepSeek 官方接口也接受 https://api.deepseek.com/v1。
LLM_BASE_URL=https://api.deepseek.com
LLM_API_KEY=

# 演员组负责角色、核查、对质、刘看山、设计稿填表、审稿、全线索盲答。官方 DeepSeek 接口关闭思考模式。
LLM_ACTOR_MODEL=deepseek-flash

# 编剧组负责对话、推理设计稿、汤面盲答。和演员同一个模型，官方 DeepSeek 接口开启思考模式。
LLM_WRITER_MODEL=deepseek-flash

# 编剧地址、密钥分别可选；留空时分别使用上面的共用配置。
# 换成 OpenAI 等其他服务时，同时把 LLM_WRITER_MODEL 改为该服务的模型名。
LLM_WRITER_BASE_URL=
LLM_WRITER_API_KEY=

# 共用地址换成 OpenAI 等其他服务时，也需要显式填写对应的演员模型名。
# 旧配置 LLM_MODEL 仍可作为演员模型的回退；新配置优先使用 LLM_ACTOR_MODEL。
